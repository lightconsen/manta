<?xml version="1.0" encoding="utf-8"?>
<!--
  The embedded syscity gateway serves plain HTTP on loopback; everything else
  stays cleartext-forbidden. (The manifest must NOT also set
  android:usesCleartextTraffic — that attribute would override this config.)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
