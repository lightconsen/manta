# Syscity Local Development Configuration
# Copy this file to .env and fill in your actual API keys
# .env is gitignored — never commit it

# ── Provider: DeepSeek ──────────────────────────────────────────────────────
# SYSCITY_BASE_URL=https://api.deepseek.com/v1
# SYSCITY_API_KEY=sk-your-deepseek-key
# SYSCITY_IS_ANTHROPIC=false
# SYSCITY_MODEL=deepseek-v4-pro
# SYSCITY_MODEL_PROVIDER=deepseek

# ── Provider: Kimi (Anthropic-compatible) ───────────────────────────────────
# SYSCITY_BASE_URL=https://api.kimi.com/coding/
# SYSCITY_API_KEY=sk-your-kimi-key
# SYSCITY_IS_ANTHROPIC=true
# SYSCITY_MODEL=kimi-for-coding

# ── Provider: Qwen (DashScope) ──────────────────────────────────────────────
SYSCITY_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
SYSCITY_API_KEY=sk-your-qwen-key
SYSCITY_IS_ANTHROPIC=false
SYSCITY_MODEL=qwen3.5-plus
SYSCITY_MODEL_PROVIDER=openai

# ── Common settings ─────────────────────────────────────────────────────────
SYSCITY_VECTOR_MEMORY_ENABLED=false

# Optional: Enable debug logging
# RUST_LOG=debug

# Optional: Increase tool iteration limit for complex tasks (default: 10-30)
# SYSCITY_MAX_TOOL_ITERATIONS=50
