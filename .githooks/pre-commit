#!/usr/bin/env bash
#
# Pre-commit gate: mirrors the CI "Security Audit" job locally.
#
# Runs scripts/audit.sh (cargo audit + cargo-deny) and rejects the commit on
# any failure, so RUSTSEC advisories surface at commit time instead of after
# a push breaks CI.
#
# Bypass in emergencies: git commit --no-verify

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$ROOT" ]]; then
    echo "pre-commit: not inside a git repository" >&2
    exit 1
fi
cd "$ROOT"

echo ""
echo "🔒 pre-commit: staged checks + security audit"
echo "   bypass with: git commit --no-verify"
echo ""

# Fast staged-content checks (conflict markers, oversized files, rustfmt,
# secrets) reject immediately before the slower audit runs.
if ! ./scripts/staged-checks.sh; then
    echo ""
    echo "❌  Staged-content checks failed — commit rejected."
    echo "    Fix the files above or unstage them:"
    echo "    git restore --staged <file>"
    echo "    Emergency bypass: git commit --no-verify"
    exit 1
fi

if ./scripts/audit.sh; then
    exit 0
fi

# First run failed. Retry once with the cached advisory DB so a transient
# advisory-db fetch failure (offline / flaky GitHub) doesn't block commits.
# Real findings fail both runs, so the gate stays strict. cargo-deny has no
# --no-fetch, so run it --offline against its local advisory DB cache.
echo ""
echo "⚠️   audit failed — retrying once with the cached advisory DB"
echo ""
if cargo audit --stale --no-fetch && cargo deny --offline check; then
    echo ""
    echo "✅  Passed on retry with the cached advisory DB."
    exit 0
fi

echo ""
echo "❌  Security audit failed — commit rejected."
echo "    Fix the findings above and retry."
echo "    Emergency bypass (not recommended): git commit --no-verify"
exit 1
